// Vaste link naar de laatst verzonden nieuwsbrief — voor het project
// nlfr-nieuwsbrief (Next.js, App Router-variant).
//
// PLAATSING — controleer eerst welke structuur de repo heeft:
//   - Staat er een map `app/`   → gebruik DIT bestand als
//     app/api/nieuwsbrief/route.js
//   - Staat er een map `pages/` → gebruik in plaats hiervan
//     pages/api/nieuwsbrief.js (meegeleverd als apart bestand)
//
// Vereist in Vercel (Settings → Environment Variables van nlfr-nieuwsbrief):
//   LAPOSTA_API_KEY — als die er al staat voor de automatisering: niets doen.
//   NIEUWSBRIEF_FILTER (optioneel) — tekstfilter op campagnenaam/onderwerp,
//     nodig als het account ook andere campagnes verstuurt.
//
// Resultaat: GET /api/nieuwsbrief → 302 naar de webversie van de laatst
// verzonden Laposta-campagne. 10 minuten CDN-cache.

export const dynamic = "force-dynamic";

export async function GET() {
  const key = process.env.LAPOSTA_API_KEY;
  if (!key) {
    return new Response("Configuratiefout: LAPOSTA_API_KEY ontbreekt in Vercel.", { status: 500 });
  }
  const filter = (process.env.NIEUWSBRIEF_FILTER || "").toLowerCase();

  try {
    const r = await fetch("https://api.laposta.nl/v2/campaign", {
      headers: { Authorization: "Basic " + Buffer.from(key + ":").toString("base64") },
      cache: "no-store"
    });
    if (!r.ok) {
      return new Response("Laposta-API gaf status " + r.status + " terug.", { status: 502 });
    }
    const j = await r.json();

    const sent = (j.data || [])
      .map((x) => x.campaign)
      .filter((c) => c && c.delivery_started && c.web)
      .filter((c) => !filter ||
        (c.name || "").toLowerCase().includes(filter) ||
        (c.subject || "").toLowerCase().includes(filter))
      .sort((a, b) => (b.delivery_started_iso || "").localeCompare(a.delivery_started_iso || ""));

    if (!sent.length) {
      return new Response("Geen verzonden nieuwsbrief gevonden" + (filter ? ` met filter '${filter}'.` : "."), { status: 404 });
    }

    return new Response(null, {
      status: 302,
      headers: {
        Location: sent[0].web,
        "Cache-Control": "s-maxage=600, stale-while-revalidate=3600"
      }
    });
  } catch (e) {
    return new Response("Laposta-API niet bereikbaar.", { status: 502 });
  }
}
