# Env-vars voor de route /actueel. Zet deze in Vercel (Project → Settings →
# Environment Variables). Zet ze NIET in de repo. De feedpagina zelf werkt ook
# zonder deze vars (alleen de AI-synthese en de reviewtool hebben ze nodig).

# Anthropic API-sleutel voor de AI-synthese (lib/synthese.js).
ANTHROPIC_API_KEY=

# ---- Inloggen op /review (Supabase Auth) -----------------------------------
# Zie docs/login.md. De eerste twee zijn PUBLIEKE waarden: ze staan in de
# browser en dat hoort zo. Het voorvoegsel NEXT_PUBLIC_ is hier alleen een naam
# — dit project is geen Next.js en heeft geen buildstap die er iets mee doet.
# De secret key van Supabase komt in dit project niet voor en is niet nodig.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Wie er op /review mag. Kommagescheiden e-mailadressen, hoofdletterongevoelig.
# LEEG = NIEMAND, met opzet: een variabele die per ongeluk niet is gezet mag de
# deur niet openzetten.
ALLOWED_LOGIN_EMAILS=

# Geheim voor de cron-endpoint (/api/cron). Vercel Cron stuurt dit mee als
# Authorization: Bearer <CRON_SECRET>. Kies iets lang en willekeurigs.
CRON_SECRET=

# Vercel KV / Upstash Redis (opslag concepten + publicaties). Deze twee vars
# komen automatisch mee als je in Vercel een KV-store aan het project koppelt.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Geheim token voor de beheerpagina van de banner (/banner-beheer). Gaat als
# "Authorization: Bearer <BANNER_TOKEN>" naar POST /api/banner; staat nooit in
# een URL. Los van de login op /review: wie de banner beheert hoeft niet ook
# bij de redactietool te kunnen. Kies iets lang en willekeurigs.
BANNER_TOKEN=
