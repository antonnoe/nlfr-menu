{
  "cleanUrls": true,
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/auth/callback", "destination": "/api/auth-callback" }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "7 * * * *" },
    { "path": "/api/selectie-cron", "schedule": "37 * * * *" }
  ]
}
